# Backend OAuth configuration. Never commit real values to this file.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8084/login/oauth2/code/google
BRIDGELABZ_EMAIL_DOMAIN=bridgelabz.com
PCCOE_ALLOWED_EMAILS=

# Frontend/Backend URLs (configure for production)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend proxy configuration
BACKEND_URL=http://localhost:8084